{% extends 'layout/base.twig' %}
{% import 'logs/_macros.twig' as m %}

{% set title = 'Cron Runs - Logs' %}
{% set pageTitle = 'Logs' %}

{% block content %}
{% include 'logs/_tabs.twig' %}

{% if not tablesReady %}{{ m.not_ready() }}{% endif %}

{# Run now #}
<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-5">
    {% for key, job in jobs %}
    {% set h = health[key] %}
    <div class="bg-white dark:bg-slate-800 rounded-lg border {{ h.state in ['late', 'failing'] ? 'border-red-300 dark:border-red-500/40' : 'border-gray-200 dark:border-slate-700' }} p-4">
        <div class="flex items-center justify-between gap-2">
            <div class="min-w-0">
                <p class="font-semibold text-gray-900 dark:text-white"><i class="fas fa-{{ job.icon }} text-gray-400 dark:text-slate-500 mr-2"></i>{{ job.label }}</p>
                <p class="text-xs text-gray-500 dark:text-slate-400 mt-0.5 truncate">
                    {{ h.last_started_at ? 'Last run ' ~ h.last_started_at|date('M d, H:i') : 'Never ran' }} · cron/{{ job.script }}
                </p>
            </div>
            {{ m.health_state(h.state) }}
        </div>
        {% if h.message and h.state in ['late', 'failing', 'never'] %}
        <p class="mt-2 text-xs {{ h.state == 'never' ? 'text-gray-500 dark:text-slate-400' : 'text-red-700 dark:text-red-400' }}">{{ h.message }}</p>
        {% endif %}
        <form method="POST" action="/logs/cron/run" class="mt-3" onsubmit="return confirmRun(event, '{{ job.label|e('js') }}')">
            {{ csrf_field() }}
            <input type="hidden" name="job" value="{{ key }}">
            <button type="submit" {{ not canRunNow or not tablesReady or h.state == 'running' ? 'disabled' : '' }}
                class="w-full px-3 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark transition-colors text-sm font-medium disabled:opacity-50 disabled:cursor-not-allowed">
                <i class="fas fa-play mr-2"></i>{{ h.state == 'running' ? 'Running…' : 'Run now' }}
            </button>
        </form>
    </div>
    {% endfor %}
</div>
{% if not canRunNow %}
<p class="mb-5 text-sm text-amber-700 dark:text-amber-400"><i class="fas fa-info-circle mr-1"></i>Run now is not available: this server does not allow PHP to run commands (exec is disabled).</p>
{% endif %}

{# Filters #}
<form method="GET" action="/logs/cron" class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 p-4 mb-4 flex flex-wrap items-end gap-3">
    <div>
        <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Job</label>
        <select name="job" class="{{ m.select_class() }}">
            <option value="">All jobs</option>
            {% for key, job in jobs %}<option value="{{ key }}" {{ filters.job == key ? 'selected' : '' }}>{{ job.label }}</option>{% endfor %}
        </select>
    </div>
    <div>
        <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Result</label>
        <select name="status" class="{{ m.select_class() }}">
            <option value="">Any result</option>
            <option value="success" {{ filters.status == 'success' ? 'selected' : '' }}>Success</option>
            <option value="partial" {{ filters.status == 'partial' ? 'selected' : '' }}>Finished with errors</option>
            <option value="failed" {{ filters.status == 'failed' ? 'selected' : '' }}>Failed</option>
            <option value="running" {{ filters.status == 'running' ? 'selected' : '' }}>Running / did not finish</option>
        </select>
    </div>
    <div>
        <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Started by</label>
        <select name="trigger" class="{{ m.select_class() }}">
            <option value="">Cron or Run now</option>
            <option value="cron" {{ filters.trigger == 'cron' ? 'selected' : '' }}>Cron</option>
            <option value="manual" {{ filters.trigger == 'manual' ? 'selected' : '' }}>Run now</option>
        </select>
    </div>
    <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark text-sm font-medium"><i class="fas fa-filter mr-2"></i>Apply</button>
    <a href="/logs/cron" class="px-4 py-2 border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 rounded-lg hover:bg-gray-50 dark:hover:bg-slate-700 text-sm font-medium">Clear</a>
</form>

<div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden">
    {% if runs is not empty %}
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700 text-sm">
            <thead class="bg-gray-50 dark:bg-slate-900">
                <tr>
                    {% for col in ['Job', 'Started', 'Duration', 'Result', 'Checked', 'Alerts sent', 'Errors', 'Started by'] %}
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-slate-400 uppercase tracking-wider whitespace-nowrap">{{ col }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
                {% for run in runs %}
                <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/50 cursor-pointer" onclick="window.location='/logs/cron/{{ run.id }}'">
                    <td class="px-4 py-3 whitespace-nowrap"><a href="/logs/cron/{{ run.id }}" class="font-medium text-gray-900 dark:text-white hover:text-primary">{{ jobs[run.job].label|default(run.job) }}</a></td>
                    <td class="px-4 py-3 whitespace-nowrap text-gray-600 dark:text-slate-400">{{ (run.started_at ?: run.created_at)|date('M d, H:i:s') }}</td>
                    <td class="px-4 py-3 whitespace-nowrap text-gray-600 dark:text-slate-400">{{ m.duration(run.duration_ms) }}</td>
                    <td class="px-4 py-3 whitespace-nowrap">{{ m.run_status(run.effective_status) }}</td>
                    <td class="px-4 py-3 text-gray-900 dark:text-white">{{ run.items_checked }}</td>
                    <td class="px-4 py-3 text-gray-900 dark:text-white">{{ run.alerts_sent }}</td>
                    <td class="px-4 py-3 {{ run.errors > 0 ? 'text-red-600 dark:text-red-400 font-semibold' : 'text-gray-900 dark:text-white' }}">{{ run.errors }}</td>
                    <td class="px-4 py-3 whitespace-nowrap text-gray-600 dark:text-slate-400">{{ run.trigger_type == 'manual' ? 'Run now · ' ~ (run.username ?: 'deleted user') : 'Cron' }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    {{ m.empty_state('clock', 'No cron runs found', filters.job or filters.status or filters.trigger ? 'No runs match these filters.' : 'Runs appear here after the cron jobs run once on v1.4.0.') }}
    {% endif %}
</div>
{{ m.pagination(pagination, filters) }}
{% endblock %}

{% block scripts %}
<script>
async function confirmRun(event, label) {
    event.preventDefault();
    const ok = await confirmAction({
        title: 'Run now',
        message: 'Run the ' + label + ' now? It works exactly like the cron job, so it can take a while and may send alerts.',
        confirmText: 'Run now',
        confirmClass: 'bg-primary hover:bg-primary-dark',
        icon: 'fa-play text-primary'
    });
    if (ok) event.target.submit();
    return false;
}
</script>
{% endblock %}
