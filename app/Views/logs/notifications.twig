{% extends 'layout/base.twig' %}
{% import 'logs/_macros.twig' as m %}

{% set title = 'Notifications Sent - Logs' %}
{% set pageTitle = 'Logs' %}

{% block content %}
{% include 'logs/_tabs.twig' %}

<form method="GET" action="/logs/notifications" class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 p-4 mb-4 flex flex-wrap items-end gap-3">
    <div>
        <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Result</label>
        <select name="status" class="{{ m.select_class() }}">
            <option value="">Sent and failed</option>
            <option value="sent" {{ filters.status == 'sent' ? 'selected' : '' }}>Sent</option>
            <option value="failed" {{ filters.status == 'failed' ? 'selected' : '' }}>Failed</option>
        </select>
    </div>
    <div>
        <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Channel</label>
        <select name="channel" class="{{ m.select_class() }}">
            <option value="">All channels</option>
            {% for channel in channels %}<option value="{{ channel }}" {{ filters.channel == channel ? 'selected' : '' }}>{{ channel|capitalize }}</option>{% endfor %}
        </select>
    </div>
    <div class="flex-1 min-w-[12rem]">
        <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Search</label>
        <input type="text" name="q" value="{{ filters.q }}" placeholder="Domain, message or type" class="w-full {{ m.select_class() }}">
    </div>
    <button type="submit" class="px-4 py-2 bg-primary text-white rounded-lg hover:bg-primary-dark text-sm font-medium"><i class="fas fa-filter mr-2"></i>Apply</button>
    <a href="/logs/notifications" class="px-4 py-2 border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 rounded-lg hover:bg-gray-50 dark:hover:bg-slate-700 text-sm font-medium">Clear</a>
</form>

<div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden">
    {% if logs is not empty %}
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700 text-sm">
            <thead class="bg-gray-50 dark:bg-slate-900">
                <tr>
                    {% for col in ['Sent', 'Domain', 'Alert', 'Channel', 'Result'] %}
                    <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-slate-400 uppercase tracking-wider whitespace-nowrap">{{ col }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
                {% for log in logs %}
                <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/50 align-top">
                    <td class="px-4 py-3 whitespace-nowrap text-gray-600 dark:text-slate-400">{{ log.sent_at|date('M d, H:i') }}</td>
                    <td class="px-4 py-3 whitespace-nowrap">
                        {% if log.domain_name %}
                        <a href="/domains/{{ log.domain_id }}" class="font-medium text-gray-900 dark:text-white hover:text-primary">{{ log.domain_name }}</a>
                        {% else %}
                        <span class="text-gray-400 dark:text-slate-500">Deleted domain</span>
                        {% endif %}
                    </td>
                    <td class="px-4 py-3">
                        <p class="text-gray-900 dark:text-white">{{ log.message }}</p>
                        <p class="text-xs text-gray-500 dark:text-slate-400 font-mono">{{ log.notification_type }}</p>
                    </td>
                    <td class="px-4 py-3 whitespace-nowrap text-gray-600 dark:text-slate-400">{{ log.channel_type|capitalize }}</td>
                    <td class="px-4 py-3">
                        {% if log.status == 'sent' %}
                        <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-green-100 dark:bg-green-500/10 text-green-800 dark:text-green-400"><i class="fas fa-check mr-1"></i>Sent</span>
                        {% else %}
                        <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-red-100 dark:bg-red-500/10 text-red-800 dark:text-red-400"><i class="fas fa-times mr-1"></i>Failed</span>
                        {% if log.error_message %}<p class="mt-1 text-xs text-red-700 dark:text-red-400">{{ log.error_message }}</p>{% endif %}
                        {% endif %}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    {{ m.empty_state('paper-plane', 'No notifications found', filters.status or filters.channel or filters.q ? 'Nothing matches these filters.' : 'Alerts sent to email, Telegram, Slack and other channels appear here.') }}
    {% endif %}
</div>
{{ m.pagination(pagination, filters) }}
<p class="mt-3 text-xs text-gray-500 dark:text-slate-400">Failing channel? Test it from its <a href="/groups" class="text-primary hover:underline">notification group</a>. The channel's own log is under <a href="/logs/files" class="text-primary hover:underline">Files</a> (e.g. telegram_channel).</p>
{% endblock %}
