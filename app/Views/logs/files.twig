{% extends 'layout/base.twig' %}
{% import 'logs/_macros.twig' as m %}

{% set title = 'Log Files - Logs' %}
{% set pageTitle = 'Logs' %}

{% block content %}
{% include 'logs/_tabs.twig' %}

<form method="GET" action="/logs/files" class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 p-4 mb-4 flex flex-wrap items-end gap-3">
    <div>
        <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Log</label>
        <select name="channel" class="{{ m.select_class() }}" onchange="this.form.submit()">
            <option value="">All logs</option>
            {% for channel in channels %}<option value="{{ channel }}" {{ filters.channel == channel ? 'selected' : '' }}>{{ channel }}</option>{% endfor %}
        </select>
    </div>
    <p class="text-sm text-gray-500 dark:text-slate-400 self-center">
        {{ files|length }} file(s), {{ totalSize|format_bytes }}.
        {{ retentionDays > 0 ? 'Dated files older than ' ~ retentionDays ~ ' days are deleted automatically.' : 'Files are kept forever.' }}
    </p>
</form>

<form method="POST" action="/logs/files/delete" id="deleteForm">
    {{ csrf_field() }}
    <div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden">
        <div id="bulkBar" class="hidden px-5 py-2.5 bg-blue-50 dark:bg-blue-500/10 border-b border-blue-200 dark:border-blue-500/20 flex items-center justify-between">
            <span id="selectedCount" class="text-sm font-medium text-gray-700 dark:text-slate-300"></span>
            <button type="button" onclick="deleteSelected()" class="px-3 py-1.5 bg-red-600 text-white rounded-lg hover:bg-red-700 text-sm font-medium"><i class="fas fa-trash mr-1"></i>Delete selected</button>
        </div>
        {% if files is not empty %}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-slate-700 text-sm">
                <thead class="bg-gray-50 dark:bg-slate-900">
                    <tr>
                        <th class="px-4 py-3 text-left"><input type="checkbox" id="selectAll" onchange="toggleAll(this)" class="rounded border-gray-300 dark:border-slate-600 text-primary focus:ring-primary" aria-label="Select all"></th>
                        {% for col in ['File', 'Log', 'Size', 'Last written', ''] %}
                        <th class="px-4 py-3 text-left text-xs font-semibold text-gray-600 dark:text-slate-400 uppercase tracking-wider whitespace-nowrap">{{ col }}</th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-slate-700">
                    {% for f in files %}
                    <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/50">
                        <td class="px-4 py-2.5"><input type="checkbox" name="files[]" value="{{ f.name }}" class="file-cb rounded border-gray-300 dark:border-slate-600 text-primary focus:ring-primary" onchange="updateBar()" aria-label="Select {{ f.name }}"></td>
                        <td class="px-4 py-2.5 font-mono text-xs"><a href="/logs/files/view?file={{ f.name|url_encode }}" class="text-gray-900 dark:text-white hover:text-primary">{{ f.name }}</a></td>
                        <td class="px-4 py-2.5 text-gray-600 dark:text-slate-400">{{ f.channel }}</td>
                        <td class="px-4 py-2.5 whitespace-nowrap text-gray-600 dark:text-slate-400">{{ f.size|format_bytes }}</td>
                        <td class="px-4 py-2.5 whitespace-nowrap text-gray-600 dark:text-slate-400">{{ f.modified|date('M d, Y H:i') }}</td>
                        <td class="px-4 py-2.5 whitespace-nowrap text-right">
                            <a href="/logs/files/view?file={{ f.name|url_encode }}" class="text-blue-600 dark:text-blue-400 hover:text-blue-800 mr-3" title="View"><i class="fas fa-eye"></i></a>
                            <a href="/logs/files/download?file={{ f.name|url_encode }}" class="text-gray-600 dark:text-slate-400 hover:text-gray-900 dark:hover:text-white" title="Download"><i class="fas fa-download"></i></a>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% else %}
        {{ m.empty_state('file-lines', 'No log files', 'The logs/ folder is empty.') }}
        {% endif %}
    </div>
</form>
<p class="mt-3 text-xs text-gray-500 dark:text-slate-400"><i class="fas fa-shield-alt mr-1"></i>Passwords, tokens and webhook secrets are replaced with *** when files are viewed or downloaded here. The files on the server are unchanged.</p>
{% endblock %}

{% block scripts %}
<script>
function toggleAll(box) {
    document.querySelectorAll('.file-cb').forEach(cb => { cb.checked = box.checked; });
    updateBar();
}
function updateBar() {
    const checked = document.querySelectorAll('.file-cb:checked').length;
    document.getElementById('bulkBar').classList.toggle('hidden', checked === 0);
    document.getElementById('selectedCount').textContent = checked + ' file(s) selected';
}
async function deleteSelected() {
    const checked = document.querySelectorAll('.file-cb:checked').length;
    const ok = await confirmAction({ message: 'Delete ' + checked + ' log file(s)? This cannot be undone.' });
    if (ok) document.getElementById('deleteForm').submit();
}
</script>
{% endblock %}
