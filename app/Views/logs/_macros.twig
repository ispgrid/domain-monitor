{# Shared bits for the Logs pages #}

{% macro duration(ms) %}
{%- if ms is null -%}
    —
{%- elseif ms < 1000 -%}
    {{ ms }}ms
{%- elseif ms < 60000 -%}
    {{ (ms / 1000)|number_format(1) }}s
{%- else -%}
    {{ (ms / 60000)|round(0, 'floor') }}m {{ ((ms % 60000) / 1000)|round }}s
{%- endif -%}
{% endmacro %}

{% macro run_status(status) %}
{% set map = {
    'success': ['green', 'check-circle', 'Success'],
    'partial': ['amber', 'exclamation-circle', 'Finished with errors'],
    'failed': ['red', 'times-circle', 'Failed'],
    'running': ['blue', 'spinner fa-spin', 'Running'],
    'queued': ['blue', 'hourglass-half', 'Starting'],
    'interrupted': ['red', 'plug', 'Did not finish'],
    'not_started': ['red', 'ban', 'Did not start']
} %}
{% set s = map[status]|default(['gray', 'question-circle', status|capitalize]) %}
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold whitespace-nowrap bg-{{ s[0] }}-100 dark:bg-{{ s[0] }}-500/10 text-{{ s[0] }}-800 dark:text-{{ s[0] }}-400 border border-{{ s[0] }}-200 dark:border-{{ s[0] }}-500/20">
    <i class="fas fa-{{ s[1] }} mr-1"></i>{{ s[2] }}
</span>
{% endmacro %}

{% macro health_state(state) %}
{% set map = {
    'ok': ['green', 'check-circle', 'On time'],
    'running': ['blue', 'spinner fa-spin', 'Running'],
    'late': ['red', 'clock', 'Late'],
    'failing': ['red', 'times-circle', 'Failing'],
    'never': ['gray', 'minus-circle', 'Never ran']
} %}
{% set s = map[state]|default(['gray', 'question-circle', state]) %}
<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold whitespace-nowrap bg-{{ s[0] }}-100 dark:bg-{{ s[0] }}-500/10 text-{{ s[0] }}-800 dark:text-{{ s[0] }}-400">
    <i class="fas fa-{{ s[1] }} mr-1"></i>{{ s[2] }}
</span>
{% endmacro %}

{% macro empty_state(icon, title, text) %}
<div class="text-center py-12 px-6">
    <i class="fas fa-{{ icon }} text-gray-300 dark:text-slate-600 text-5xl mb-4"></i>
    <h3 class="text-base font-semibold text-gray-700 dark:text-slate-300 mb-1">{{ title }}</h3>
    <p class="text-sm text-gray-500 dark:text-slate-400">{{ text }}</p>
</div>
{% endmacro %}

{% macro not_ready() %}
<div class="mb-4 px-4 py-3 rounded-lg border border-amber-200 dark:border-amber-500/20 bg-amber-50 dark:bg-amber-500/10 text-sm text-amber-800 dark:text-amber-300">
    <i class="fas fa-database mr-2"></i>The database update for v1.4.0 has not run yet. Go to <a href="/install/update" class="font-medium underline">the database update page</a> to finish it, then new runs will appear here.
</div>
{% endmacro %}

{% macro pagination(pagination, filters) %}
{% if pagination.total_pages > 1 %}
<div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-3">
    <p class="text-sm text-gray-600 dark:text-slate-400">
        {{ pagination.showing_from }}–{{ pagination.showing_to }} of {{ pagination.total }}
    </p>
    <div class="flex items-center gap-1">
        {% if pagination.current_page > 1 %}
        <a href="{{ pagination_url(pagination.current_page - 1, filters, pagination.per_page) }}" class="px-3 py-1.5 text-sm border border-gray-300 dark:border-slate-600 rounded-lg hover:bg-gray-50 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-300"><i class="fas fa-angle-left mr-1"></i>Previous</a>
        {% endif %}
        <span class="px-3 py-1.5 text-sm text-gray-600 dark:text-slate-400">Page {{ pagination.current_page }} of {{ pagination.total_pages }}</span>
        {% if pagination.current_page < pagination.total_pages %}
        <a href="{{ pagination_url(pagination.current_page + 1, filters, pagination.per_page) }}" class="px-3 py-1.5 text-sm border border-gray-300 dark:border-slate-600 rounded-lg hover:bg-gray-50 dark:hover:bg-slate-700 text-gray-700 dark:text-slate-300">Next<i class="fas fa-angle-right ml-1"></i></a>
        {% endif %}
    </div>
</div>
{% elseif pagination.total > 0 %}
<p class="mt-3 text-sm text-gray-500 dark:text-slate-400">{{ pagination.total }} item(s)</p>
{% endif %}
{% endmacro %}

{% macro select_class() %}px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg focus:ring-2 focus:ring-primary focus:border-primary text-sm bg-white dark:bg-slate-900 text-gray-900 dark:text-white{% endmacro %}
