{% extends 'layout/base.twig' %}

{% set title = 'Integrations' %}
{% set pageTitle = 'Integrations' %}
{% set pageDescription = 'Connect registrar and DNS provider accounts' %}
{% set pageIcon = 'fas fa-plug' %}

{% block content %}
{% if accounts is null %}
<div class="bg-amber-50 dark:bg-amber-500/10 border border-amber-200 dark:border-amber-500/30 rounded-lg p-4 text-sm text-amber-800 dark:text-amber-300">
    Integrations are not available yet. An admin needs to finish the update under <strong>Settings → Updates</strong>.
</div>
{% else %}

<div class="mb-4 bg-blue-50 dark:bg-blue-500/10 border border-blue-200 dark:border-blue-500/30 rounded-lg p-4 text-sm text-blue-800 dark:text-blue-300">
    <p class="font-semibold mb-1"><i class="fas fa-info-circle mr-1"></i> Read only</p>
    <p>Domain Monitor only reads from these accounts, it never changes anything there. Cloudflare zones are matched to your domains by name, and each domain's <strong>DNS tab → Cloudflare</strong> compares the zone with public DNS. When they still differ after {{ graceMinutes }} minutes, the domain's notification group is alerted (the group's DNS alert switch applies). Zones are read again with every DNS check, or with <strong>Sync now</strong>.</p>
</div>

{# Accounts #}
<div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden mb-6">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-700">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Your accounts</h2>
    </div>
    {% if accounts is empty %}
    <div class="p-8 text-center text-sm text-gray-500 dark:text-slate-400">
        <i class="fas fa-plug text-gray-300 dark:text-slate-600 mb-3" style="font-size: 32px;"></i>
        <p>No accounts connected yet.</p>
    </div>
    {% else %}
    <div class="divide-y divide-gray-200 dark:divide-slate-700">
        {% for account in accounts %}
        <div class="px-6 py-4">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
                <div>
                    <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-sm font-semibold text-gray-900 dark:text-white">{{ account.label }}</span>
                        <span class="px-2 py-0.5 rounded text-xs font-medium bg-orange-100 dark:bg-orange-500/10 text-orange-800 dark:text-orange-400">{{ providers[account.provider].label|default(account.provider) }}</span>
                        {% if not account.is_active %}
                        <span class="px-2 py-0.5 rounded text-xs font-medium bg-gray-100 dark:bg-slate-700 text-gray-600 dark:text-slate-400">Paused</span>
                        {% endif %}
                        {% if account.last_status == 'error' %}
                        <span class="px-2 py-0.5 rounded text-xs font-medium bg-red-100 dark:bg-red-500/10 text-red-700 dark:text-red-400">Sync problem</span>
                        {% elseif account.last_status == 'ok' %}
                        <span class="px-2 py-0.5 rounded text-xs font-medium bg-green-100 dark:bg-green-500/10 text-green-700 dark:text-green-400">OK</span>
                        {% endif %}
                    </div>
                    <p class="text-xs text-gray-500 dark:text-slate-400 mt-1">
                        {{ account.zone_count }} zone(s) matched to domains
                        · Last sync: {{ account.last_sync_at ? account.last_sync_at|date('M d, Y H:i') : 'never' }}
                    </p>
                    {% if account.last_status == 'error' and account.last_error %}
                    <p class="text-xs text-red-600 dark:text-red-400 mt-1">{{ account.last_error }}</p>
                    {% endif %}
                </div>
                <div class="flex items-center gap-2">
                    <form method="POST" action="/integrations/{{ account.id }}/sync" onsubmit="this.querySelector('button').disabled = true; this.querySelector('i').classList.add('fa-spin');">
                        {{ csrf_field() }}
                        <button type="submit" class="inline-flex items-center px-3 py-1.5 bg-green-600 text-white text-xs rounded-lg hover:bg-green-700 font-medium">
                            <i class="fas fa-sync-alt mr-1.5" style="font-size: 10px;"></i>Sync now
                        </button>
                    </form>
                    <button type="button" onclick="document.getElementById('edit-{{ account.id }}').classList.toggle('hidden')" class="inline-flex items-center px-3 py-1.5 border border-gray-300 dark:border-slate-600 text-gray-700 dark:text-slate-300 text-xs rounded-lg hover:bg-gray-50 dark:hover:bg-slate-700 font-medium">
                        <i class="fas fa-edit mr-1.5" style="font-size: 10px;"></i>Edit
                    </button>
                    <form method="POST" action="/integrations/{{ account.id }}/delete" onsubmit="return confirmSubmit(event, 'Remove this integration? Its saved zones are deleted too. Nothing changes at the provider.')">
                        {{ csrf_field() }}
                        <button type="submit" class="inline-flex items-center px-3 py-1.5 bg-red-600 text-white text-xs rounded-lg hover:bg-red-700 font-medium">
                            <i class="fas fa-trash mr-1.5" style="font-size: 10px;"></i>Remove
                        </button>
                    </form>
                </div>
            </div>

            <form id="edit-{{ account.id }}" method="POST" action="/integrations/{{ account.id }}/update" class="hidden mt-4 grid grid-cols-1 md:grid-cols-2 gap-3 max-w-2xl" autocomplete="off">
                {{ csrf_field() }}
                <div>
                    <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Name</label>
                    <input type="text" name="label" value="{{ account.label }}" maxlength="100" required class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white">
                </div>
                {% for name, field in providers[account.provider].fields|default({}) %}
                <div>
                    <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">New {{ field.label|lower }}</label>
                    <input type="{{ field.type }}" name="credentials[{{ name }}]" value="" autocomplete="new-password" placeholder="Leave blank to keep the saved one" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white">
                </div>
                {% endfor %}
                <label class="flex items-center gap-2 text-sm text-gray-700 dark:text-slate-300">
                    <input type="checkbox" name="is_active" value="1" {{ account.is_active ? 'checked' : '' }} class="rounded border-gray-300 dark:border-slate-600 text-primary">
                    Sync with the DNS checks
                </label>
                <div class="md:col-span-2">
                    <button type="submit" class="px-4 py-2 bg-primary text-white text-sm rounded-lg hover:bg-primary-dark font-medium">Save</button>
                </div>
            </form>
        </div>
        {% endfor %}
    </div>
    {% endif %}
</div>

{# Add account #}
<div class="bg-white dark:bg-slate-800 rounded-lg border border-gray-200 dark:border-slate-700 overflow-hidden">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-slate-700">
        <h2 class="text-sm font-semibold text-gray-900 dark:text-white">Connect an account</h2>
    </div>
    <form method="POST" action="/integrations" class="p-6 space-y-4 max-w-2xl" autocomplete="off" onsubmit="this.querySelector('button[type=submit]').disabled = true;">
        {{ csrf_field() }}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <div>
                <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Provider</label>
                <select name="provider" id="integrationProvider" onchange="showProviderFields(this.value)" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white">
                    {% for key, provider in providers %}
                    <option value="{{ key }}">{{ provider.label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">Name</label>
                <input type="text" name="label" maxlength="100" required placeholder="e.g. Main Cloudflare" class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white">
            </div>
        </div>
        {% for key, provider in providers %}
        <div class="provider-fields space-y-3{{ loop.first ? '' : ' hidden' }}" data-provider="{{ key }}">
            {% for name, field in provider.fields %}
            <div>
                <label class="block text-xs font-medium text-gray-700 dark:text-slate-300 mb-1">{{ field.label }}</label>
                <input type="{{ field.type }}" name="credentials[{{ name }}]" autocomplete="new-password" {{ field.required ? 'required' : '' }} class="w-full px-3 py-2 border border-gray-300 dark:border-slate-600 rounded-lg text-sm bg-white dark:bg-slate-700 text-gray-900 dark:text-white">
                {% if field.help %}<p class="mt-1 text-xs text-gray-500 dark:text-slate-400">{{ field.help }}</p>{% endif %}
            </div>
            {% endfor %}
        </div>
        {% endfor %}
        <p class="text-xs text-gray-500 dark:text-slate-400"><i class="fas fa-lock mr-1"></i>Credentials are stored encrypted and are never shown again.</p>
        <button type="submit" class="px-4 py-2 bg-primary text-white text-sm rounded-lg hover:bg-primary-dark font-medium">
            <i class="fas fa-plug mr-1.5"></i>Test and connect
        </button>
    </form>
</div>

<script>
function showProviderFields(key) {
    document.querySelectorAll('.provider-fields').forEach(function (block) {
        var active = block.dataset.provider === key;
        block.classList.toggle('hidden', !active);
        block.querySelectorAll('input').forEach(function (input) { input.disabled = !active; });
    });
}
showProviderFields(document.getElementById('integrationProvider').value);
</script>
{% endif %}
{% endblock %}
