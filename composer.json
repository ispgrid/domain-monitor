{
    "name": "ispgrid/domain-monitor",
    "description": "A powerful, self-hosted domain expiration monitoring system with multi-channel notifications",
    "type": "project",
    "license": "MIT",
    "keywords": ["domain", "monitoring", "whois", "rdap", "notifications", "expiration", "alerts", "telegram", "discord", "slack"],
    "homepage": "https://github.com/ispgrid/domain-monitor",
    "authors": [
        {
            "name": "ispgrid",
            "homepage": "https://github.com/ispgrid",
            "role": "Maintainer"
        },
        {
            "name": "Hosteroid",
            "email": "support@hosteroid.uk",
            "homepage": "https://hosteroid.uk",
            "role": "Original author"
        }
    ],
    "support": {
        "issues": "https://github.com/ispgrid/domain-monitor/issues",
        "source": "https://github.com/ispgrid/domain-monitor",
        "docs": "https://github.com/ispgrid/domain-monitor#readme"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "endroid/qr-code": "^6.0",
        "guzzlehttp/guzzle": "^8.3",
        "lbuchs/webauthn": "^2.2",
        "phpmailer/phpmailer": "^7.1",
        "pragmarx/google2fa": "^9.1",
        "twig/twig": "^3.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Core\\": "core/"
        }
    },
    "require-dev": {
        "symfony/var-dumper": "^7.4"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.2"
        },
        "preferred-install": "dist",
        "sort-packages": true
    }
}
