# Example Docker environment file
# Copy this file to .env.docker and update your credentials

# This file is read by the shell: put values with spaces or & # $ ; in single quotes,
# e.g. DB_PASSWORD='p&ss#word'. Keep it private: chmod 600 .env.docker

# === Database Configuration ===
DB_DATABASE=domain_monitor
DB_USERNAME=user_example
DB_PASSWORD=example_password
DB_ROOT_PASSWORD=example_root_password

# === Timezone (for PHP, MariaDB, phpMyAdmin) ===
TZ=UTC

# === phpMyAdmin ===
# Listens on 127.0.0.1:8081 only. Use 0.0.0.0 to reach it from other machines (not recommended).
#PMA_BIND=127.0.0.1

